PORT=3000
# Cole aqui a connection string PostgreSQL do seu banco (local ou Supabase).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/fibra
# Use true para conexoes Supabase que exigem SSL.
DATABASE_SSL=false
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
CORS_ORIGIN=http://localhost:5500

# Opcional: habilita sincronizacao manual e agendada com o HubSpot.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CNPJ_PROPERTY=
HUBSPOT_SYNC_CRON=0 0 * * *
